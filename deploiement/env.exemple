# Modèle du fichier « .env » à placer à la racine du projet SUR LE SERVEUR.
# Ne le mettez jamais dans un dépôt Git : il contient des secrets.
#
# Copiez-le, renommez-le « .env », et remplacez les valeurs marquées.

# Nom d'hôte de votre application. Remplacez « VOTRENOM ».
SUIVI_HOTES=VOTRENOM.pythonanywhere.com

# Obligatoire en ligne : sans cela, la moindre erreur afficherait le code
# source et les réglages de l'application à qui visite l'adresse.
SUIVI_DEBUG=0

# Clé secrète Django. Générez la vôtre, ne reprenez pas celle du poste local :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SUIVI_CLE=REMPLACEZ_PAR_UNE_CLE_GENEREE

# Jeton attendu de l'application Android. Générez-en un nouveau pour le
# serveur en ligne, et reportez-le dans les Réglages de l'application :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SUIVI_JETON_API=REMPLACEZ_PAR_UN_JETON_GENERE

# Base de données. SQLite convient : la base pèse moins d'un mégaoctet et
# l'application n'a qu'un utilisateur. Décommentez le bloc MySQL seulement si
# votre compte y a droit (créé avant le 15 janvier 2026).
# SUIVI_BASE=mysql
# SUIVI_MYSQL_NOM=VOTRENOM$compteurs
# SUIVI_MYSQL_UTILISATEUR=VOTRENOM
# SUIVI_MYSQL_MOTDEPASSE=
# SUIVI_MYSQL_HOTE=VOTRENOM.mysql.pythonanywhere-services.com
