.venv/
.outils/
__pycache__/
*.py[cod]
*.log

# Base locale, secrets et fichiers produits
db.sqlite3

# Fichiers de configuration d'environnement, où qu'ils se trouvent : ils
# portent les secrets. Le motif est volontairement large — un fichier déposé
# à la racine plutôt que dans deploiement/ doit être couvert lui aussi.
.env
env.*
!deploiement/env.exemple
staticfiles/
media/
donnees*.json
sauvegarde*.json
deploiement/*.zip

# Données personnelles : douze ans de consommation. Elles n'ont pas leur place
# dans un dépôt, surtout public. Le classeur reste sur votre PC, et le serveur
# reçoit les données une fois, par « exporter_donnees » puis « loaddata ».
compteur.xlsx
~$*.xlsx

# L'APK pèse 49 Mo : un dépôt n'est pas un entrepôt de binaires. Il se
# reconstruit en une commande depuis les sources présentes dans android/.
deploiement/*.apk

# Clé de publication Android. La perdre interdit toute mise à jour de
# l'application déjà installée : sauvegardez-la hors du dépôt.
android/cle-release.jks
android/keystore.properties
deploiement/cle-android-base64.txt

# Projet Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

.idea/
.vscode/
