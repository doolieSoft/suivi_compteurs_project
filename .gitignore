# Outils locaux
.venv/
.outils/
__pycache__/
*.log
.idea/
.vscode/

# Données personnelles : elles n'ont pas leur place dans un dépôt public.
# Restes du site d'origine, conservés sur le PC.
compteur.xlsx
~$*.xlsx
db.sqlite3
media/
donnees*.json
sauvegarde*.json
.env
env.*
deploiement/*.zip

# L'APK pèse 50 Mo : un dépôt n'est pas un entrepôt de binaires. Il se
# reconstruit en une commande, et chaque publication GitHub l'attache.
deploiement/*.apk

# Clé de publication Android. La perdre interdit toute mise à jour de
# l'application déjà installée : sauvegardez-la hors du dépôt.
android/cle-release.jks
android/keystore.properties
deploiement/cle-android-base64.txt

# Projet Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
