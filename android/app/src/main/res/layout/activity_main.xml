<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plan">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="@string/app_name" />

    <TextView
        android:id="@+id/etat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bandeau_calme"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/encre_2"
        android:textSize="13sp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/rafraichir"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liste"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp" />

            <LinearLayout
                android:id="@+id/listeVide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/messageVide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/encre_2"
                    android:textSize="15sp" />

                <!-- Premier lancement : créer sa maison. Reprendre une
                     sauvegarde reste possible, mais en second : un nouvel
                     utilisateur n'a pas de classeur. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boutonCreer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/creer_maison" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boutonImporter"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/reprendre_sauvegarde" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/reprendre_sauvegarde_aide"
                    android:textColor="@color/encre_3"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- L'analyse, à portée de main sous les compteurs (aussi dans le menu). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/boutonConsulter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/consulter"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="@string/tirer_pour_synchroniser"
        android:textColor="@color/encre_3"
        android:textSize="12sp" />
</LinearLayout>
