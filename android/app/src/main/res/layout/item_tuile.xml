<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Repère coloré de l'énergie, comme sur l'application web. -->
        <!-- Icône de l'énergie, dans sa couleur. -->
        <ImageView
            android:id="@+id/pastille"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_eau" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/encre_2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valeur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/encre"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/periode"
                style="@style/TexteTuile"
                android:textColor="@color/encre_2" />

            <!-- Tendance depuis le relevé précédent : ↑ plus pessimiste, ↓ plus optimiste. -->
            <TextView
                android:id="@+id/tendance"
                style="@style/TexteTuile"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/detail"
                style="@style/TexteTuile" />

            <TextView
                android:id="@+id/fourchette"
                style="@style/TexteTuile" />

            <TextView
                android:id="@+id/evolution"
                style="@style/TexteTuile"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cout"
                style="@style/TexteTuile" />

            <TextView
                android:id="@+id/anomalies"
                style="@style/TexteTuile"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/methode"
                style="@style/TexteTuile"
                android:layout_marginTop="8dp"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
