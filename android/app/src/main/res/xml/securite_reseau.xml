<?xml version="1.0" encoding="utf-8"?>
<!-- Le serveur Django tourne en HTTP sur le réseau domestique. Android bloque
     le trafic en clair depuis Android 9 ; on l'autorise, car chiffrer une
     liaison vers une machine du même Wi-Fi n'apporterait rien ici et imposerait
     de gérer un certificat. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
